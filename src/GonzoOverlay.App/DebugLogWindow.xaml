<Window x:Class="GonzoOverlay.App.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GonzoOverlay — Debug Log"
        Width="1100"
        Height="650"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LogHeading"
                   Text="Telemetry debug log"
                   Foreground="#182235"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <TextBox x:Name="LogTextBox"
                 Grid.Row="1"
                 Margin="0,12,0,12"
                 Padding="8"
                 Background="#101722"
                 Foreground="#D7E3F2"
                 BorderBrush="#5276AE"
                 FontFamily="Consolas"
                 FontSize="12"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Copy"
                    Click="CopyButton_OnClick" />
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Clear"
                    Click="ClearButton_OnClick" />
            <Button Width="90"
                    Height="32"
                    Content="Close"
                    Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
