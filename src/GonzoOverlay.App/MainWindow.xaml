<Window x:Class="GonzoOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GonzoOverlay — konfigurator"
        Width="520"
        Height="430"
        MinWidth="520"
        MinHeight="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        Closed="MainWindow_OnClosed">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="GONZOOVERLAY"
                       Foreground="#5276AE"
                       FontSize="12"
                       FontWeight="Bold" />
            <TextBlock Margin="0,6,0,0"
                       Text="Overlay configurator"
                       Foreground="#182235"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0"
                       Text="Overlay automatycznie dopasuje się do monitora, na którym znajduje się konfigurator."
                       Foreground="#667085"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,28,0,12"
                   Text="Widgety"
                   Foreground="#27364D"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="WeatherWidgetCheckBox"
                      Content="Pogoda toru — wilgotność nawierzchni"
                      Foreground="#27364D"
                      FontSize="13"
                      IsChecked="True" />
            <CheckBox x:Name="PitSpeedHelperWidgetCheckBox"
                      Margin="0,10,0,0"
                      Content="Pit Speed Helper"
                      Foreground="#27364D"
                      FontSize="13"
                      IsChecked="False" />
            <CheckBox x:Name="StandingsWidgetCheckBox"
                      Margin="0,10,0,0"
                      Content="Standings"
                      Foreground="#27364D"
                      FontSize="13"
                      IsChecked="True" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,24,0,18">
            <TextBlock x:Name="StatusText"
                       Foreground="#667085"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <Button x:Name="DebugLogButton"
                    Width="100"
                    Height="28"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Content="Debug Log"
                    Click="ToggleDebugLog_OnClick" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="StopButton"
                    Width="110"
                    Height="34"
                    Margin="0,0,10,0"
                    Content="Stop overlay"
                    Click="StopOverlay_OnClick"
                    IsEnabled="False" />
            <Button x:Name="EditButton"
                    Width="110"
                    Height="34"
                    Margin="0,0,10,0"
                    Content="Edit mode"
                    Click="ToggleEditMode_OnClick"
                    IsEnabled="False" />
            <Button x:Name="StartButton"
                    Width="130"
                    Height="34"
                    Content="Start overlay"
                    Click="StartOverlay_OnClick"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
