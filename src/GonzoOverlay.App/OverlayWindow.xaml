<Window x:Class="GonzoOverlay.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GonzoOverlay"
        Width="240"
        Height="88"
        MinWidth="120"
        MinHeight="50"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Loaded="OverlayWindow_OnLoaded"
        Closed="OverlayWindow_OnClosed"
        PreviewMouseLeftButtonDown="OverlayWindow_OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OverlayWindow_OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OverlayWindow_OnPreviewMouseLeftButtonUp">
    <Border x:Name="OverlayBorder"
            Background="#E6111620"
            BorderBrush="#FF3C82F6"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <wv2:WebView2 x:Name="OverlayWebView" />
            <Border x:Name="EditHitArea"
                    Background="Transparent"
                    IsHitTestVisible="True"
                    Visibility="Collapsed" />
            <Border x:Name="EditModeHint"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="12,6"
                    Background="#DD0B2A4A"
                    BorderBrush="#FF009DFF"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock Text="EDIT MODE — przeciągnij / zmień rozmiar"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="Bold"
                           TextAlignment="Center" />
            </Border>
            <Border x:Name="ResizeGrip"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,2,2"
                    Background="#AA168CFF"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
