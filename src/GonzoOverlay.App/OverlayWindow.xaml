<Window x:Class="GonzoOverlay.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GonzoOverlay"
        Width="1"
        Height="1"
        MinWidth="1"
        MinHeight="1"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Loaded="OverlayWindow_OnLoaded"
        Closed="OverlayWindow_OnClosed">
    <Border x:Name="OverlayBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0">
        <Grid>
            <wv2:WebView2 x:Name="OverlayWebView" />
            <Canvas x:Name="EditSurface"
                    Background="Transparent"
                    Visibility="Collapsed"
                    MouseMove="EditSurface_OnMouseMove"
                    MouseLeftButtonUp="EditSurface_OnMouseLeftButtonUp" />
            <Border x:Name="EditModeHint"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="12,6"
                    Background="#DD0B2A4A"
                    BorderBrush="#FF009DFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock Foreground="White"
                           FontSize="11"
                           FontWeight="Bold"
                           Text="EDIT MODE — przeciągnij widgety / użyj uchwytu resize" />
            </Border>
        </Grid>
    </Border>
</Window>
